<mxfile host="drawio"><diagram name="Architecture" id="Architecture"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Epistemic Provenance Graph: two-lane memory architecture" style="text;html=1;fillColor=none;strokeColor=none;fontColor=#1a1a1a;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1500" height="40" as="geometry"/></mxCell><mxCell id="c4" value="HOT PATH: critical path (0 LLM calls, ≤150 ms p95)" style="fontFamily=Helvetica;fontSize=13;html=1;whiteSpace=wrap;fontColor=#1a1a1a;rounded=1;arcSize=3;fillColor=none;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;strokeColor=#6c8ebf;fontColor=#1f4e8c;" vertex="1" parent="1"><mxGeometry x="20" y="55" width="1460" height="215" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Task Queue&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;5,000 tasks/day · 200 orgs&lt;br&gt;org_id + task_context&lt;/font&gt;" style="fontFamily=Helvetica;fontSize=13;html=1;whiteSpace=wrap;fontColor=#1a1a1a;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="50" y="110" width="250" height="120" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;Hybrid Recall + IFC Gate&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;BM25 + vector + 1-hop graph&lt;br&gt;score = sim × conf × decay&lt;br&gt;pack ≤4k tokens, tag [id], no T3 actions&lt;/font&gt;" style="fontFamily=Helvetica;fontSize=13;html=1;whiteSpace=wrap;fontColor=#1a1a1a;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="390" y="110" width="280" height="120" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Headless Agent Loop&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Black-box LLM + tools&lt;br&gt;reads untrusted inputs&lt;/font&gt;" style="fontFamily=Helvetica;fontSize=13;html=1;whiteSpace=wrap;fontColor=#1a1a1a;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="770" y="110" width="270" height="120" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Write Staging Push&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;≤3 candidate claims + cited [id]s&lt;br&gt;emitted in final step (0 extra LLM)&lt;/font&gt;" style="fontFamily=Helvetica;fontSize=13;html=1;whiteSpace=wrap;fontColor=#1a1a1a;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1120" y="110" width="330" height="120" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;External inputs (untrusted)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;email · web · uploads · tickets&lt;/font&gt;" style="fontFamily=Helvetica;fontSize=13;html=1;whiteSpace=wrap;fontColor=#1a1a1a;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="770" y="290" width="270" height="60" as="geometry"/></mxCell><mxCell id="c10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;fontColor=#333333;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c11" value="≤4k tokens" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;fontColor=#333333;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;fontColor=#333333;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;fontColor=#333333;dashed=1;strokeColor=#b85450;" edge="1" parent="1" source="c9" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="&lt;b&gt;Epistemic Provenance DAG (org-partitioned)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;Claim nodes + DERIVED_FROM / CONTESTED_BY / SUPERSEDES edges · bi-temporal validity · CAS version&lt;/font&gt;" style="fontFamily=Helvetica;fontSize=13;html=1;whiteSpace=wrap;fontColor=#1a1a1a;shape=cylinder;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="150" y="380" width="1200" height="90" as="geometry"/></mxCell><mxCell id="c15" value="recall (ACTIVE / CONTESTED)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;fontColor=#333333;exitX=0.2;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="c14" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="SLEEP-TIME ASYNC LANE: off critical path (~0.08 to 0.30 LLM calls/run avg)" style="fontFamily=Helvetica;fontSize=13;html=1;whiteSpace=wrap;fontColor=#1a1a1a;rounded=1;arcSize=3;fillColor=none;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;strokeColor=#d79b00;fontColor=#8a5a00;" vertex="1" parent="1"><mxGeometry x="20" y="510" width="1460" height="230" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;1. Deterministic Gate + CAS&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;verify tool logs → T0–T3 (non-amplifying)&lt;br&gt;exact match → pos++&lt;br&gt;T3 → QUARANTINED · 0 LLM&lt;/font&gt;" style="fontFamily=Helvetica;fontSize=13;html=1;whiteSpace=wrap;fontColor=#1a1a1a;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="45" y="565" width="330" height="140" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;2. Batched Conflict Revision&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;only entity collisions / sim &gt; 0.82&lt;br&gt;5 pairs per LLM call →&lt;br&gt;CONFIRM / SUPERSEDE / COEXIST / REJECT&lt;/font&gt;" style="fontFamily=Helvetica;fontSize=13;html=1;whiteSpace=wrap;fontColor=#1a1a1a;rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="400" y="565" width="330" height="140" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;3. JTMS Error Containment&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;1 LLM attribution per flagged report&lt;br&gt;walk back → root, forward → BFS&lt;br&gt;quarantine unsupported subgraph (0 LLM)&lt;/font&gt;" style="fontFamily=Helvetica;fontSize=13;html=1;whiteSpace=wrap;fontColor=#1a1a1a;rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="755" y="565" width="330" height="140" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;4. Global k-anon &amp; Decay&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;PII scrub · k ≥ 10 orgs → global (1 batch LLM)&lt;br&gt;nightly Ebbinghaus pruning&lt;br&gt;cap 10k/org · compact leaves &gt; 90 d&lt;/font&gt;" style="fontFamily=Helvetica;fontSize=13;html=1;whiteSpace=wrap;fontColor=#1a1a1a;rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1110" y="565" width="345" height="140" as="geometry"/></mxCell><mxCell id="c21" value="async queue" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;fontColor=#333333;exitX=0.92;exitY=1;entryX=0;entryY=0.5;dashed=1;" edge="1" parent="1" source="c8" target="c17"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1424" y="492"/><mxPoint x="30" y="492"/><mxPoint x="30" y="635"/></Array></mxGeometry></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;fontColor=#333333;" edge="1" parent="1" source="c17" target="c18"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;fontColor=#333333;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;fontColor=#333333;" edge="1" parent="1" source="c19" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;fontColor=#333333;dashed=1;strokeColor=#999999;endArrow=open;exitX=0.5;exitY=0;entryY=1;entryX=0.050;" edge="1" parent="1" source="c17" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;fontColor=#333333;dashed=1;strokeColor=#999999;endArrow=open;exitX=0.5;exitY=0;entryY=1;entryX=0.346;" edge="1" parent="1" source="c18" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;fontColor=#333333;dashed=1;strokeColor=#999999;endArrow=open;exitX=0.5;exitY=0;entryY=1;entryX=0.642;" edge="1" parent="1" source="c19" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;fontColor=#333333;dashed=1;strokeColor=#999999;endArrow=open;exitX=0.5;exitY=0;entryY=1;entryX=0.943;" edge="1" parent="1" source="c20" target="c14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="&lt;b&gt;Delayed human feedback&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;~2% of outputs, days later&lt;/font&gt;" style="fontFamily=Helvetica;fontSize=13;html=1;whiteSpace=wrap;fontColor=#1a1a1a;rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="755" y="770" width="330" height="60" as="geometry"/></mxCell><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;fontColor=#333333;strokeColor=#9673a6;" edge="1" parent="1" source="c29" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="" style="fontFamily=Helvetica;fontSize=13;html=1;whiteSpace=wrap;fontColor=#1a1a1a;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="45" y="770" width="22" height="22" as="geometry"/></mxCell><mxCell id="c32" value="0 LLM calls (rules / stats)" style="text;html=1;fillColor=none;strokeColor=none;fontColor=#1a1a1a;fontSize=12;align=left;verticalAlign=middle;fontFamily=Helvetica;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="72" y="770" width="180" height="22" as="geometry"/></mxCell><mxCell id="c33" value="" style="fontFamily=Helvetica;fontSize=13;html=1;whiteSpace=wrap;fontColor=#1a1a1a;rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="45" y="802" width="22" height="22" as="geometry"/></mxCell><mxCell id="c34" value="Batched, off-path LLM calls" style="text;html=1;fillColor=none;strokeColor=none;fontColor=#1a1a1a;fontSize=12;align=left;verticalAlign=middle;fontFamily=Helvetica;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="72" y="802" width="220" height="22" as="geometry"/></mxCell><mxCell id="c35" value="" style="fontFamily=Helvetica;fontSize=13;html=1;whiteSpace=wrap;fontColor=#1a1a1a;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="300" y="770" width="22" height="22" as="geometry"/></mxCell><mxCell id="c36" value="Untrusted input (T3)" style="text;html=1;fillColor=none;strokeColor=none;fontColor=#1a1a1a;fontSize=12;align=left;verticalAlign=middle;fontFamily=Helvetica;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="327" y="770" width="200" height="22" as="geometry"/></mxCell><mxCell id="c37" value="" style="fontFamily=Helvetica;fontSize=13;html=1;whiteSpace=wrap;fontColor=#1a1a1a;rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="300" y="802" width="22" height="22" as="geometry"/></mxCell><mxCell id="c38" value="Human signal (T0)" style="text;html=1;fillColor=none;strokeColor=none;fontColor=#1a1a1a;fontSize=12;align=left;verticalAlign=middle;fontFamily=Helvetica;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="327" y="802" width="200" height="22" as="geometry"/></mxCell><mxCell id="c39" value="&lt;b&gt;Budget:&lt;/b&gt; ~400 LLM calls/day ≈ 0.08 per run (cap 2.0)&lt;br&gt;&lt;b&gt;Latency:&lt;/b&gt; ≤150 ms p95 added (cap 300 ms)" style="text;html=1;fillColor=none;strokeColor=none;fontColor=#1a1a1a;fontSize=12;align=left;verticalAlign=middle;fontFamily=Helvetica;whiteSpace=wrap;fillColor=#f5f5f5;strokeColor=#666666;rounded=1;spacingLeft=8;" vertex="1" parent="1"><mxGeometry x="1110" y="770" width="345" height="60" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>