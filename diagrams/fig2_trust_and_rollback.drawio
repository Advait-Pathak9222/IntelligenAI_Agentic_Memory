<mxfile host="drawio"><diagram name="TrustRollback" id="TrustRollback"><mxGraphModel dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c3" value="Trust gating and causal rollback" style="text;html=1;fillColor=none;strokeColor=none;fontColor=#1a1a1a;fontSize=20;fontStyle=1;align=center;verticalAlign=middle;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1500" height="40" as="geometry"/></mxCell><mxCell id="c4" value="A. IFC non-amplification and quarantine (scenarios 1 and 2)" style="fontFamily=Helvetica;fontSize=13;html=1;whiteSpace=wrap;fontColor=#1a1a1a;rounded=1;arcSize=3;fillColor=none;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;strokeColor=#b85450;fontColor=#8c2a26;" vertex="1" parent="1"><mxGeometry x="20" y="55" width="720" height="560" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;External ticket&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;T3_UNTRUSTED&lt;br&gt;“escalate to billing-help@acme-support.co”&lt;/font&gt;" style="fontFamily=Helvetica;fontSize=13;html=1;whiteSpace=wrap;fontColor=#1a1a1a;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="120" width="180" height="90" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;QUARANTINED claim&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;prior (0,2) · conf 0.25&lt;br&gt;N × T3 repeats cannot promote&lt;/font&gt;" style="fontFamily=Helvetica;fontSize=13;html=1;whiteSpace=wrap;fontColor=#1a1a1a;rounded=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="290" y="120" width="180" height="90" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Action sink gate&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;blocks auto-CC to domains&lt;br&gt;not on Acme&#x27;s T1 allowlist&lt;/font&gt;" style="fontFamily=Helvetica;fontSize=13;html=1;whiteSpace=wrap;fontColor=#1a1a1a;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="540" y="120" width="180" height="90" as="geometry"/></mxCell><mxCell id="c8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;fontColor=#333333;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c9" value="hint only" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;fontColor=#333333;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c10" value="&lt;b&gt;Independent check&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;T1 CRM / DKIM / tool read&lt;br&gt;or T0 human approval&lt;/font&gt;" style="fontFamily=Helvetica;fontSize=13;html=1;whiteSpace=wrap;fontColor=#1a1a1a;rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="180" height="100" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;ACTIVE claim&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;new valid_from window&lt;br&gt;trust = min_trust(sources)&lt;/font&gt;" style="fontFamily=Helvetica;fontSize=13;html=1;whiteSpace=wrap;fontColor=#1a1a1a;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="290" y="330" width="180" height="100" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;Old claim&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;valid_to closed&lt;br&gt;→ SUPERSEDED (kept for audit)&lt;/font&gt;" style="fontFamily=Helvetica;fontSize=13;html=1;whiteSpace=wrap;fontColor=#1a1a1a;rounded=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="540" y="330" width="180" height="100" as="geometry"/></mxCell><mxCell id="c13" value="triggered on next relevant task" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;fontColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c7" target="c10"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c14" value="corroborates" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;fontColor=#333333;" edge="1" parent="1" source="c10" target="c11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c15" value="SUPERSEDES" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;fontColor=#333333;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c16" value="&lt;b&gt;Rule:&lt;/b&gt; a T3 claim may only add a CONTESTED_BY edge to a T0–T2 claim; it never silently overwrites one. Real updates are not lost: the sink gate turns them into a T1 check or a T0 approval request instead of an action. (0 LLM calls)" style="text;html=1;fillColor=none;strokeColor=none;fontColor=#1a1a1a;fontSize=12;align=left;verticalAlign=middle;fontFamily=Helvetica;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="50" y="470" width="670" height="120" as="geometry"/></mxCell><mxCell id="c17" value="B. Bidirectional JTMS rollback (scenario 3)" style="fontFamily=Helvetica;fontSize=13;html=1;whiteSpace=wrap;fontColor=#1a1a1a;rounded=1;arcSize=3;fillColor=none;strokeWidth=2;dashed=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=6;fontStyle=1;fontSize=15;strokeColor=#9673a6;fontColor=#5b3b73;" vertex="1" parent="1"><mxGeometry x="770" y="55" width="720" height="560" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Human flag&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;report #40 marked wrong&lt;br&gt;(days later)&lt;/font&gt;" style="fontFamily=Helvetica;fontSize=13;html=1;whiteSpace=wrap;fontColor=#1a1a1a;rounded=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="790" y="120" width="200" height="90" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Fault attribution&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;1 async LLM call over&lt;br&gt;the report&#x27;s recalled [id]s&lt;/font&gt;" style="fontFamily=Helvetica;fontSize=13;html=1;whiteSpace=wrap;fontColor=#1a1a1a;rounded=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1030" y="120" width="200" height="90" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;C_utc (root)&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;walk DERIVED_FROM back&lt;br&gt;→ RETRACTED&lt;/font&gt;" style="fontFamily=Helvetica;fontSize=13;html=1;whiteSpace=wrap;fontColor=#1a1a1a;rounded=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;dashed=1;" vertex="1" parent="1"><mxGeometry x="1270" y="120" width="190" height="90" as="geometry"/></mxCell><mxCell id="c21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;fontColor=#333333;" edge="1" parent="1" source="c18" target="c19"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;fontColor=#333333;" edge="1" parent="1" source="c19" target="c20"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c23" value="&lt;b&gt;Derived claims A..M&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;supported only by C_utc&lt;br&gt;→ QUARANTINED (0 LLM)&lt;/font&gt;" style="fontFamily=Helvetica;fontSize=13;html=1;whiteSpace=wrap;fontColor=#1a1a1a;rounded=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1030" y="330" width="200" height="100" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;Derived claims N..O&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;have independent T1 support&lt;br&gt;→ stay ACTIVE, conf penalised&lt;/font&gt;" style="fontFamily=Helvetica;fontSize=13;html=1;whiteSpace=wrap;fontColor=#1a1a1a;rounded=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1270" y="330" width="190" height="100" as="geometry"/></mxCell><mxCell id="c25" value="forward BFS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;fontColor=#333333;exitX=0.2;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c20" target="c23"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c26" value="keep if alt. support" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;fontColor=#333333;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="c20" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c27" value="&lt;b&gt;Independent T1&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;alternate proof&lt;/font&gt;" style="fontFamily=Helvetica;fontSize=13;html=1;whiteSpace=wrap;fontColor=#1a1a1a;rounded=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1290" y="450" width="150" height="50" as="geometry"/></mxCell><mxCell id="c28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;fontColor=#333333;dashed=1;" edge="1" parent="1" source="c27" target="c24"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c29" value="&lt;b&gt;Audit log&lt;/b&gt;&lt;br&gt;&lt;font style=&#x27;font-size:11px&#x27;&gt;40 affected run_ids&lt;br&gt;listed for review&lt;/font&gt;" style="fontFamily=Helvetica;fontSize=13;html=1;whiteSpace=wrap;fontColor=#1a1a1a;rounded=1;fillColor=#f5f5f5;strokeColor=#666666;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="790" y="330" width="200" height="100" as="geometry"/></mxCell><mxCell id="c30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;strokeWidth=2;endArrow=block;endFill=1;fontSize=12;labelBackgroundColor=#ffffff;fontColor=#333333;dashed=1;" edge="1" parent="1" source="c23" target="c29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="c31" value="&lt;b&gt;Effect:&lt;/b&gt; future recall stops using every claim that rests only on the bad root; past reports are flagged by run_id, not rewritten." style="text;html=1;fillColor=none;strokeColor=none;fontColor=#1a1a1a;fontSize=12;align=left;verticalAlign=middle;fontFamily=Helvetica;whiteSpace=wrap;fillColor=#fff2cc;strokeColor=#d6b656;rounded=1;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="790" y="520" width="670" height="70" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>